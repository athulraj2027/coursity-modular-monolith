# ==========================================
# Coursity - Docker Environment Variables
# ==========================================

# Environment Mode (production | development)
NODE_ENV=production

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coursity
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=3000
JWT_SECRET=super_secret_jwt_key_coursity_2026_change_me
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_coursity_2026_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP / Email Service Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Coursity <noreply@coursity.com>"
ENABLE_IN_PROCESS_WORKER=true

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# AWS S3 Storage Configuration (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_CLOUDFRONT_URL=
AWS_S3_ENDPOINT=

# Frontend Configuration
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=Coursity
VITE_APP_URL=http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
VITE_ENABLE_DEVTOOLS=false


