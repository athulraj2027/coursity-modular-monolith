# =========================================================================
# Coursity AI Interview Microservice Environment Configuration
# =========================================================================

# Server Network & Runtime
PORT=4000
NODE_ENV=development

# Core Backend HTTP Integration (apps/http)
HTTP_BACKEND_URL=http://localhost:3000
INTERNAL_SERVICE_SECRET=coursity_internal_microservice_shared_secret_2026

# Realtime Token Verification Secret (Shared with apps/http)
JWT_SECRET=super_secret_interview_realtime_token_key

# -------------------------------------------------------------------------
# Purpose- & Capability-Based AI Model Configuration
# -------------------------------------------------------------------------

# 1. Reasoning & Cognitive LLM (Planning, Question Gen, Evaluation, Analysis)
# Provider choices: gemini | openai | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=

# 2. Speech-to-Text / Audio Transcription (Candidate voice streaming -> text)
# Provider choices: deepgram | whisper | livekit
STT_PROVIDER=deepgram
STT_MODEL=nova-2
STT_API_KEY=

# 3. Text-to-Speech / Voice Synthesis (Interviewer voice audio synthesis)
# Provider choices: elevenlabs | cartesia | openai
TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_turbo_v2_5
TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TTS_API_KEY=

# -------------------------------------------------------------------------
# Session Audio Cloud Storage Archive
# -------------------------------------------------------------------------
STORAGE_REGION=us-east-1
STORAGE_BUCKET_NAME=coursity-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
