# ==============================================================================
# Coursity Media SFU Node - Environment Variables
# ==============================================================================

# Runtime Environment
NODE_ENV=development
PORT=5000
NODE_ID=media-node-local-1

# Redis Cluster / Instance (Room Registry & Heartbeats)
REDIS_URL=redis://localhost:6379

# Inter-Service Authentication (Join Tokens & Control Plane)
JWT_SECRET=super_secret_jwt_key_coursity_2026

# Mediasoup Worker & RTC Settings
# Number of Mediasoup workers to spawn (defaults to os.cpus().length)
MEDIASOUP_NUM_WORKERS=0
MEDIASOUP_LOG_LEVEL=warn

# WebRTC Port Range (Ensure these UDP ports are open in security group / firewall)
RTC_MIN_PORT=20000
RTC_MAX_PORT=20100

# IP Address Configuration
# In Local Docker/Dev: 127.0.0.1 or your local LAN IP (e.g., 192.168.1.X)
# In Production AWS/GCP/K8s: The public IP of the host machine / EC2 instance
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# Heartbeat Interval in Milliseconds (defaults to 5000ms)
HEARTBEAT_INTERVAL_MS=5000

# apps/http Core Backend URL (for webhooks & attendance reporting)
CORE_BACKEND_URL=http://localhost:3000
