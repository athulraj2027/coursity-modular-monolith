// ==========================================
// COURSE & PLATFORM CATEGORIES HIERARCHY
// ==========================================

model Category {
  id          String     @id @default(uuid())
  name        String     // e.g. "Software Engineering", "Frontend Development"
  slug        String     @unique // e.g. "software-engineering", "frontend-development"
  description String?    @db.Text
  icon        String?    // Lucide icon identifier (e.g. "Code2", "Palette", "BrainCircuit", "Briefcase")
  image       String?    // Category showcase banner/thumbnail URL
  
  // Hierarchical Parent/Subcategory Self-Relation
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")

  // Visibility & Display
  isActive    Boolean    @default(true)
  isFeatured  Boolean    @default(false)
  sortOrder   Int        @default(0)

  // Soft Deletion
  isDeleted   Boolean    @default(false)
  deletedAt   DateTime?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive, isDeleted, sortOrder])
  @@map("categories")
}
