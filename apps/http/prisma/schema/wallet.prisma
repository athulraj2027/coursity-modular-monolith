// ==========================================
// WALLET & LEDGER SCHEMA
// ==========================================

enum WalletStatus {
  ACTIVE
  FROZEN
  SUSPENDED
}

enum TransactionType {
  DEPOSIT               // Student top-up via payment gateway
  ENROLLMENT_PAYMENT    // Course purchase debit
  EARNING               // Teacher course sales royalty credit
  REFUND                // Refund credit for cancelled enrollment
  PAYOUT_WITHDRAWAL     // Teacher withdrawal debit to bank/UPI
  ADJUSTMENT            // Admin manual credit/debit adjustment
  CASHBACK_BONUS        // Platform incentive / promotional credit
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

model Wallet {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Balances
  balance         Decimal        @default(0.00) @db.Decimal(12, 2)
  lockedBalance   Decimal        @default(0.00) @db.Decimal(12, 2) // Funds locked during active payout requests
  currency        String         @default("INR")
  status          WalletStatus   @default(ACTIVE)
  
  // Aggregated Analytics
  totalEarned     Decimal        @default(0.00) @db.Decimal(12, 2) // Lifetime teacher earnings
  totalSpent      Decimal        @default(0.00) @db.Decimal(12, 2) // Lifetime student purchases
  totalWithdrawn  Decimal        @default(0.00) @db.Decimal(12, 2) // Lifetime teacher payouts
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  transactions    WalletTransaction[]
  payoutRequests  PayoutRequest[]

  @@index([userId, status])
  @@map("wallets")
}

model WalletTransaction {
  id                String               @id @default(uuid())
  walletId          String
  wallet            Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  // Ledger Accounting
  type              TransactionType
  direction         TransactionDirection
  amount            Decimal              @db.Decimal(12, 2)
  balanceBefore     Decimal              @db.Decimal(12, 2)
  balanceAfter      Decimal              @db.Decimal(12, 2)
  currency          String               @default("INR")
  status            TransactionStatus    @default(COMPLETED)
  
  // Context & References
  description       String
  referenceType     String?              // "ENROLLMENT", "RAZORPAY_ORDER", "PAYOUT", "ADMIN_ADJUSTMENT"
  referenceId       String?              // Related entity UUID or gateway paymentId
  
  // Payment Gateway Metadata (for deposits/top-ups)
  razorpayOrderId   String?
  razorpayPaymentId String?
  
  // Admin / Audit Metadata
  performedByUserId String?              // If triggered by an admin
  notes             String?              @db.Text

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([walletId, createdAt])
  @@index([type, status])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model PayoutRequest {
  id                 String          @id @default(uuid())
  walletId           String
  wallet             Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  userId             String
  bankDetailId       String
  bankDetail         BankDetail      @relation(fields: [bankDetailId], references: [id], onDelete: Restrict)
  
  amount             Decimal         @db.Decimal(12, 2)
  currency           String          @default("INR")
  status             PayoutStatus    @default(PENDING)
  
  // Payout Method Snapshot (in case bank details change later)
  payoutMethod       PayoutMethodType
  accountSummary     String          // e.g. "HDFC Bank ****1234" or "user@upi"
  
  // Admin Processing
  processedByUserId  String?
  processedAt        DateTime?
  rejectionReason    String?         @db.Text
  transactionRef     String?         // Bank UTR / RazorpayX Payout ID
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("payout_requests")
}
